# Preferred: paste the published CSV URL from Google Sheets.
GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/export?format=csv&gid=0

# Or provide the sheet ID and optional tab gid separately.
# GOOGLE_SHEET_ID=YOUR_SHEET_ID
# GOOGLE_SHEET_GID=0

# Optional: refresh the in-memory sheet cache every 60 seconds.
# SHEET_CACHE_TTL_MS=60000

# Optional: show a "Запропонувати мем" button linking to your Google Form.
# GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/YOUR_FORM_ID/viewform
